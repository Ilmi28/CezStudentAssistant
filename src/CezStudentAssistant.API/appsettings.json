{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "SuperSecretKeyForDevelopmentAndTestingNeedsToBeAtLeast32BytesLong!",
    "Issuer": "CezStudentAssistant",
    "Audience": "CezStudentAssistantUsers",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30,
    "RefreshTokenGracePeriodSeconds": 30
  },
  "BlobContainerSettings": {
    "CourseFilesContainer": "course-files"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CezStudentAssistantDb;Username=postgres;Password=postgres",
    "AzureBlobStorage": "UseDevelopmentStorage=true"
  },
  "Cez": {
    "ApiBaseUrl": "https://cez.wi.pb.edu.pl/"
  },
  "CezSync": {
    "StaleSyncDaysThreshold": 1,
    "CronSchedule": "0 2 * * *"
  },
  "Gemini": {
    "ApiKey": "",
    "DefaultModel": "gemini-2.0-flash",
    "MaxAttempts": 6,
    "RetryDelaysMs": [ 1000, 2000, 4000, 8000, 16000, 32000 ],
    "MaximumDailyTokens": 1000000
  }
}
